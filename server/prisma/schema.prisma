// ============================================================
// Viral Print Media - Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceType {
  TAX_INVOICE
  ESTIMATE
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentType {
  CASH
  BANK
  UPI
  CARD
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================
// COMPANY
// ============================================================

model Company {
  id           Int        @id @default(autoincrement())
  company_name String     @map("company_name")
  gst_number   String?    @map("gst_number")
  address      String?
  phone        String?
  logo         String?
  users        User[]
  customers    Customer[]
  suppliers    Supplier[]
  categories   Category[]
  products     Product[]
  purchases    Purchase[]
  invoices     Invoice[]
  tasks        Task[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("companies")
}

// ============================================================
// ROLES & PERMISSIONS
// ============================================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  label       String           @default("")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  permission_name String           @unique @map("permission_name")
  roles           RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int        @map("role_id")
  permission_id Int        @map("permission_id")
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

// ============================================================
// USERS
// ============================================================

model User {
  id            Int        @id @default(autoincrement())
  company_id    Int        @map("company_id")
  company       Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  full_name     String     @map("full_name")
  username      String     @unique
  password_hash String     @map("password_hash")
  role_id       Int        @map("role_id")
  role          Role       @relation(fields: [role_id], references: [id])
  status        UserStatus @default(ACTIVE)
  created_by    Int?       @map("created_by")
  last_login    DateTime?  @map("last_login")
  assignedTasks Task[]     @relation("AssignedTasks")
  createdTasks  Task[]     @relation("CreatedTasks")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

// ============================================================
// ACTIVITY LOG
// ============================================================

model ActivityLog {
  id         Int      @id @default(autoincrement())
  user_id    Int      @map("user_id")
  username   String
  action     String
  module     String
  detail     String?
  ip_address String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id               Int      @id @default(autoincrement())
  company_id       Int      @map("company_id")
  company          Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name             String
  mobile           String?
  email            String?
  gst_no           String?  @map("gst_no")
  billing_address  String?  @map("billing_address")
  shipping_address String?  @map("shipping_address")
  invoices         Invoice[]
  ledgers          Ledger[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id         Int        @id @default(autoincrement())
  company_id Int        @map("company_id")
  company    Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name       String
  mobile     String?
  email      String?
  gst_no     String?    @map("gst_no")
  address    String?
  purchases  Purchase[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("suppliers")
}

// ============================================================
// CATEGORIES & PRODUCTS
// ============================================================

model Category {
  id         Int       @id @default(autoincrement())
  company_id Int       @map("company_id")
  company    Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name       String
  products   Product[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([company_id, name])
  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  company_id    Int            @map("company_id")
  company       Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category_id   Int            @map("category_id")
  category      Category       @relation(fields: [category_id], references: [id])
  name          String
  unit          String         @default("pcs")
  price         Decimal        @db.Decimal(12, 2)
  gst_rate      Decimal        @db.Decimal(5, 2) @default(18.00) @map("gst_rate")
  description   String?
  purchaseItems PurchaseItem[]
  invoiceItems  InvoiceItem[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("products")
}

// ============================================================
// PURCHASES
// ============================================================

model Purchase {
  id          Int            @id @default(autoincrement())
  company_id  Int            @map("company_id")
  company     Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  supplier_id Int            @map("supplier_id")
  supplier    Supplier       @relation(fields: [supplier_id], references: [id])
  date        DateTime       @default(now())
  amount      Decimal        @db.Decimal(12, 2)
  items       PurchaseItem[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("purchases")
}

model PurchaseItem {
  purchase_id Int      @map("purchase_id")
  purchase    Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id  Int      @map("product_id")
  product     Product  @relation(fields: [product_id], references: [id])
  qty         Decimal  @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(12, 2)

  @@id([purchase_id, product_id])
  @@map("purchase_items")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id           Int           @id @default(autoincrement())
  company_id   Int           @map("company_id")
  company      Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_id  Int           @map("customer_id")
  customer     Customer      @relation(fields: [customer_id], references: [id])
  invoice_type InvoiceType   @default(TAX_INVOICE) @map("invoice_type")
  date         DateTime      @default(now())
  total        Decimal       @db.Decimal(12, 2)
  paid         Decimal       @db.Decimal(12, 2) @default(0.00)
  balance      Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(UNPAID)
  items        InvoiceItem[]
  payments     Payment[]
  ledgers      Ledger[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model InvoiceItem {
  invoice_id Int     @map("invoice_id")
  invoice    Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  product_id Int     @map("product_id")
  product    Product @relation(fields: [product_id], references: [id])
  qty        Decimal @db.Decimal(10, 2)
  price      Decimal @db.Decimal(12, 2)
  gst        Decimal @db.Decimal(12, 2)

  @@id([invoice_id, product_id])
  @@map("invoice_items")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id           Int         @id @default(autoincrement())
  invoice_id   Int         @map("invoice_id")
  invoice      Invoice     @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  amount       Decimal     @db.Decimal(12, 2)
  payment_type PaymentType @default(CASH) @map("payment_type")
  date         DateTime    @default(now())
  ledgers      Ledger[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("payments")
}

// ============================================================
// LEDGER
// ============================================================

model Ledger {
  id          Int      @id @default(autoincrement())
  customer_id Int      @map("customer_id")
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice_id  Int?     @map("invoice_id")
  invoice     Invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  payment_id  Int?     @map("payment_id")
  payment     Payment? @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  credit      Decimal  @db.Decimal(12, 2) @default(0.00)
  debit       Decimal  @db.Decimal(12, 2) @default(0.00)
  balance     Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ledger")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id             Int          @id @default(autoincrement())
  company_id     Int          @map("company_id")
  company        Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  start_date     DateTime?    @map("start_date")
  due_date       DateTime?    @map("due_date")
  assigned_to_id Int?         @map("assigned_to_id")
  assigned_to    User?        @relation("AssignedTasks", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  created_by_id  Int?         @map("created_by_id")
  created_by     User?        @relation("CreatedTasks", fields: [created_by_id], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("tasks")
}
