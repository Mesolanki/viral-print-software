// ============================================================
// Viral Print Media - Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceType {
  TAX_INVOICE
  ESTIMATE
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentType {
  CASH
  BANK
  UPI
  CARD
  OTHER
}

// ============================================================
// COMPANY
// ============================================================

model Company {
  id                Int               @id @default(autoincrement())
  company_name      String            @map("company_name")
  gst_number        String?           @map("gst_number")
  address           String?
  phone             String?
  logo              String?
  users             User[]
  customers         Customer[]
  suppliers         Supplier[]
  categories        Category[]
  products          Product[]
  purchases         Purchase[]
  invoices          Invoice[]
  expenseCategories ExpenseCategory[]
  officeExpenses    OfficeExpense[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("companies")
}

// ============================================================
// ROLES & PERMISSIONS
// ============================================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  label       String           @default("")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  permission_name String           @unique @map("permission_name")
  roles           RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int        @map("role_id")
  permission_id Int        @map("permission_id")
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

// ============================================================
// USERS
// ============================================================

model User {
  id               Int             @id @default(autoincrement())
  company_id       Int             @map("company_id")
  company          Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  full_name        String          @map("full_name")
  username         String          @unique
  password_hash    String          @map("password_hash")
  role_id          Int             @map("role_id")
  role             Role            @relation(fields: [role_id], references: [id])
  status           UserStatus      @default(ACTIVE)
  created_by       Int?            @map("created_by")
  last_login       DateTime?       @map("last_login")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  expensesRecorded OfficeExpense[] @relation("ExpenseRecorder")

  @@map("users")
}

// ============================================================
// ACTIVITY LOG
// ============================================================

model ActivityLog {
  id         Int      @id @default(autoincrement())
  user_id    Int      @map("user_id")
  username   String
  action     String
  module     String
  detail     String?
  ip_address String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id               Int      @id @default(autoincrement())
  company_id       Int      @map("company_id")
  company          Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name             String
  mobile           String?
  email            String?
  gst_no           String?  @map("gst_no")
  billing_address  String?  @map("billing_address")
  shipping_address String?  @map("shipping_address")
  invoices         Invoice[]
  ledgers          Ledger[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id         Int        @id @default(autoincrement())
  company_id Int        @map("company_id")
  company    Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name       String
  mobile     String?
  email      String?
  gst_no     String?    @map("gst_no")
  address    String?
  purchases  Purchase[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("suppliers")
}

// ============================================================
// CATEGORIES & PRODUCTS
// ============================================================

model Category {
  id         Int       @id @default(autoincrement())
  company_id Int       @map("company_id")
  company    Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name       String
  products   Product[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([company_id, name])
  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  company_id    Int            @map("company_id")
  company       Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category_id   Int            @map("category_id")
  category      Category       @relation(fields: [category_id], references: [id])
  name          String
  unit          String         @default("pcs")
  price         Decimal        @db.Decimal(12, 2)
  gst_rate      Decimal        @db.Decimal(5, 2) @default(18.00) @map("gst_rate")
  description   String?
  purchaseItems PurchaseItem[]
  invoiceItems  InvoiceItem[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("products")
}

// ============================================================
// PURCHASES
// ============================================================

model Purchase {
  id          Int            @id @default(autoincrement())
  company_id  Int            @map("company_id")
  company     Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  supplier_id Int            @map("supplier_id")
  supplier    Supplier       @relation(fields: [supplier_id], references: [id])
  date        DateTime       @default(now())
  amount      Decimal        @db.Decimal(12, 2)
  items       PurchaseItem[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("purchases")
}

model PurchaseItem {
  purchase_id Int      @map("purchase_id")
  purchase    Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id  Int      @map("product_id")
  product     Product  @relation(fields: [product_id], references: [id])
  qty         Decimal  @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(12, 2)

  @@id([purchase_id, product_id])
  @@map("purchase_items")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id           Int           @id @default(autoincrement())
  company_id   Int           @map("company_id")
  company      Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_id  Int           @map("customer_id")
  customer     Customer      @relation(fields: [customer_id], references: [id])
  invoice_type InvoiceType   @default(TAX_INVOICE) @map("invoice_type")
  date         DateTime      @default(now())
  total        Decimal       @db.Decimal(12, 2)
  paid         Decimal       @db.Decimal(12, 2) @default(0.00)
  balance      Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(UNPAID)
  items        InvoiceItem[]
  payments     Payment[]
  ledgers      Ledger[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model InvoiceItem {
  invoice_id Int     @map("invoice_id")
  invoice    Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  product_id Int     @map("product_id")
  product    Product @relation(fields: [product_id], references: [id])
  qty        Decimal @db.Decimal(10, 2)
  price      Decimal @db.Decimal(12, 2)
  gst        Decimal @db.Decimal(12, 2)

  @@id([invoice_id, product_id])
  @@map("invoice_items")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id           Int         @id @default(autoincrement())
  invoice_id   Int         @map("invoice_id")
  invoice      Invoice     @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  amount       Decimal     @db.Decimal(12, 2)
  payment_type PaymentType @default(CASH) @map("payment_type")
  date         DateTime    @default(now())
  ledgers      Ledger[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("payments")
}

// ============================================================
// LEDGER
// ============================================================

model Ledger {
  id          Int      @id @default(autoincrement())
  customer_id Int      @map("customer_id")
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice_id  Int?     @map("invoice_id")
  invoice     Invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  payment_id  Int?     @map("payment_id")
  payment     Payment? @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  credit      Decimal  @db.Decimal(12, 2) @default(0.00)
  debit       Decimal  @db.Decimal(12, 2) @default(0.00)
  balance     Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ledger")
}

// ============================================================
// OFFICE EXPENSES
// ============================================================

/// Lookup table for expense types (Rent, Electricity, Salary, etc.)
/// Company-scoped so each company can customise their categories.
model ExpenseCategory {
  id          Int             @id @default(autoincrement())
  company_id  Int             @map("company_id")
  company     Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name        String
  description String?
  is_active   Boolean         @default(true) @map("is_active")
  expenses    OfficeExpense[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Each category name must be unique per company
  @@unique([company_id, name])
  @@map("expense_categories")
}

/// Office / overhead expense record.
/// Tracks every operational cost incurred by the shop.
model OfficeExpense {
  id            Int             @id @default(autoincrement())
  company_id    Int             @map("company_id")
  company       Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category_id   Int             @map("category_id")
  category      ExpenseCategory @relation(fields: [category_id], references: [id])
  /// Short description (e.g. "Monthly office rent – July 2026")
  title         String
  amount        Decimal         @db.Decimal(12, 2)
  payment_mode  PaymentType     @default(CASH) @map("payment_mode")
  /// The actual date the expense was incurred (not the record creation date)
  expense_date  DateTime        @map("expense_date")
  /// Optional bill/receipt number for audit trail
  reference_no  String?         @map("reference_no")
  /// Vendor / payee name (landlord, electricity board, etc.)
  vendor_name   String?         @map("vendor_name")
  notes         String?
  /// User who recorded this expense entry
  recorded_by   Int             @map("recorded_by")
  recorder      User            @relation("ExpenseRecorder", fields: [recorded_by], references: [id])
  /// Future: path or URL to scanned receipt/bill image
  receipt_url   String?         @map("receipt_url")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([company_id, expense_date])
  @@index([company_id, category_id])
  @@map("office_expenses")
}
